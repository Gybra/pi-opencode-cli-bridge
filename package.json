{
  "name": "pi-opencode-cli-bridge",
  "version": "0.2.7",
  "description": "Bridge the OpenCode CLI into Pi Coding Agent",
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src/index.ts",
    "src/process.ts",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-timeout=60000 dist/index.test.js dist/process.test.js",
    "test:integration": "npm run build && node --test --test-timeout=240000 dist/native-tools.integration.test.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:integration"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/luongnv89/pi-extensions/main/assets/pi-opencode-cli-model-list.png"
  },
  "keywords": [
    "pi-package",
    "pi",
    "opencode",
    "bridge",
    "free-models",
    "custom-provider"
  ],
  "author": "pi-extensions contributors",
  "contributors": [
    {
      "name": "luongnv89",
      "url": "https://github.com/luongnv89"
    },
    {
      "name": "Rodrigo Manuel Jager Pinheiro",
      "url": "https://github.com/rodrigojager"
    },
    {
      "name": "Gybra",
      "url": "https://github.com/Gybra"
    }
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gybra/pi-opencode-cli-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Gybra/pi-opencode-cli-bridge/issues"
  },
  "homepage": "https://github.com/Gybra/pi-opencode-cli-bridge",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
